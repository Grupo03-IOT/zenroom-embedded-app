; Copiar a secrets.ini (no se versiona) y completar con la red y el broker reales.
[secrets]
build_flags =
    '-DWIFI_SSID="MiRed"'
    '-DWIFI_PASS="MiClave"'
    '-DMQTT_HOST="192.168.1.50"'
    -DMQTT_PORT=1883
    ; Si el broker pide usuario (el Mosquitto de edge-api/broker lo exige), descomenta:
    ; '-DMQTT_USER="esp32"'
    ; '-DMQTT_PASS="clave-del-broker"'
